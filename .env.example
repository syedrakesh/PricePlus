# ─── Application ───────────────────────────────────────────────────────────────
APP_ENV=development
APP_DEBUG=true
APP_SECRET_KEY=change-me-in-production-use-secrets-generate

# ─── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://priceplus:priceplus@localhost:5432/priceplus
DATABASE_TEST_URL=postgresql+asyncpg://priceplus:priceplus@localhost:5432/priceplus_test

# ─── Redis / Celery ────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ─── Auth ──────────────────────────────────────────────────────────────────────
JWT_SECRET_KEY=change-me-generate-256-bit-random-key
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# ─── Email (SMTP) ──────────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@priceplus.app
SMTP_FROM_NAME=PricePlus

# ─── Stripe ────────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
# After creating products in Stripe Dashboard, add their Price IDs:
STRIPE_PRICE_ID_STARTER=price_replace_me
STRIPE_PRICE_ID_PRO=price_replace_me

# ─── Discovery ─────────────────────────────────────────────────────────────────
DISCOVERY_HTTP_TIMEOUT=30
DISCOVERY_MAX_RETRIES=3
DISCOVERY_RATE_LIMIT_DELAY=1.0

# ─── Monitoring ────────────────────────────────────────────────────────────────
DEFAULT_POLL_INTERVAL_MINUTES=60

# ─── CORS ──────────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000
